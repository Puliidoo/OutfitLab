# Tokens de Hugging Face (crea cuentas en huggingface.co y genera tokens en Settings > Access Tokens)
HF_TOKEN_1=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_TOKEN_2=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Configuración de PostgreSQL (ajusta según tu instalación)
# usuario: postgres (por defecto)
# host: localhost
# database: OutfitLab (créala en pgAdmin o psql: CREATE DATABASE "OutfitLab";)
# password: tu contraseña de PostgreSQL
# port: 5432
